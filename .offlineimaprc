# Sample minimal config file.  Copy this to ~/.offlineimaprc and edit to
# get started fast.

[general]
accounts = Carlosatpajuelo

[Account Carlosatpajuelo]
localrepository = correol
remoterepository = correor
autorefresh = 1
postsynchook = /home/carlos/bin/offlineimap-postsync

[Repository correol]
type = Maildir
localfolders = ~/Mail

[Repository correor]
type = IMAP
remotehost = mail.pajuelo.com
remoteuser = carlos@pajuelo.com
ssl = no
sslcacertfile = /etc/ssl/certs/ca-certificates.crt

